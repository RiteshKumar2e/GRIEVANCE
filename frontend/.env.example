# GRIEVANCE frontend configuration — copy to frontend/.env.
# Only VITE_* variables are exposed to the browser. Never put secrets here.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=GRIEVANCE

# Public URL of the deployed site (used for sitemap.xml and robots.txt)
VITE_SITE_URL=http://localhost:8080
# Optional public support address shown in the footer and legal pages
VITE_SUPPORT_EMAIL=
