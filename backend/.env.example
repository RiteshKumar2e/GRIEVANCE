# ------------------------------------------------------------------
# GRIEVANCE backend configuration — copy to backend/.env and edit.
# Never commit backend/.env. Never put these values in the frontend.
# ------------------------------------------------------------------

APP_ENV=development
APP_NAME=GRIEVANCE

# Database. Local Postgres with pgvector (docker compose up db).
# For a zero-dependency dev run you may use: sqlite:///./grievance.db
DATABASE_URL=postgresql+psycopg://grievance:grievance@localhost:5432/grievance

# Auth — generate a long random value, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# LLM providers (both optional). Order: Groq -> Gemini (if Groq fails) -> deterministic rules.
# Leave both keys blank to run fully in deterministic fallback mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30

# Embeddings: auto | sentence-transformers | hashing
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Speech-to-text (requires requirements-ml.txt): auto | faster-whisper | disabled
STT_PROVIDER=auto
WHISPER_MODEL=small

# Policy defaults (category master values override these)
DEFAULT_CONFIDENCE_THRESHOLD=0.70
DUPLICATE_THRESHOLD=0.78
DUPLICATE_WINDOW_DAYS=30
DUPLICATE_RADIUS_KM=1.5
SLA_WARNING_FRACTION=0.75
AUTO_CLOSE_AFTER_DAYS=7

# Background SLA monitor (seconds between scans; 0 disables)
SLA_SCAN_INTERVAL_SECONDS=300

# Observability — Langfuse (optional). Internal tracing is always on.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Webhook signing secret used for outgoing webhook HMAC signatures
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# Seeded demo accounts (development only)
SEED_DEMO_USERS=true
# Choose your own demo password for local development; leave empty to create no demo logins. Never publish it.
DEMO_PASSWORD=

UPLOAD_DIR=./uploads

# Abuse protection
MAX_GRIEVANCES_PER_DAY=10
MAX_DRAFTS_PER_DAY=60
# Redirect HTTP->HTTPS and send HSTS (enable in production behind a TLS proxy)
ENFORCE_HTTPS=false

# data.gov.in (Open Government Data) API key for CPGRAM statistics and nodal officer directory (optional).
# Register at https://data.gov.in, then My Account -> Generate API Key.
DATA_GOV_IN_API_KEY=

# Optional real system administrator. When set, the demo admin@example.org account is not created
# (and is deactivated if it exists). The password is used only when the account is first created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME="System Administrator"
