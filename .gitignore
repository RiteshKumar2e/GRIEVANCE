# ---------------------------------------------------------------
# GRIEVANCE — root .gitignore
# ---------------------------------------------------------------

# Environment files (examples stay tracked)
.env
.env.*
!.env.example
frontend/.env
backend/.env

# Node
node_modules/
frontend/node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo
.vite/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build outputs
dist/
build/
coverage/
frontend/dist/

# Logs
*.log
logs/

# Local databases & uploads
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
backend/uploads/
backend/data/raw/*
!backend/data/raw/.gitkeep
# External datasets: original downloads are large and re-fetchable (see backend/data/external/PROVENANCE.md)
backend/data/external/*/raw/
pgdata/

# Model caches
.cache/
backend/.models/
hf_cache/

# IDE and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Secrets and local configuration
*.pem
*.key
*.p12
*.pfx
secrets/

# Office lock files
~$*
